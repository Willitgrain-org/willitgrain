---
import Layout from "@/layouts/main.astro"
import { Header } from "@/components/Header"
import { Footer } from "@/components/Footer"
---

<Layout lang="de" title="Shop | WILL IT GRAIN">
  <Header lang="de" isShopPage={true} client:load />
  
  <div class="flex-1 flex flex-col items-center justify-center p-6 px-4 md:px-10 animate-fade-up">
    <div class="max-w-4xl w-full">
      <h1 class="text-4xl md:text-5xl font-black uppercase tracking-[0.2em] mb-12 text-center mix-blend-screen text-white/90">Willitgrain Shop</h1>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        {/* Product 1: Blu-ray */}
        <div class="relative group rounded-3xl overflow-hidden bg-white/5 border border-white/10 backdrop-blur-md p-6 flex flex-col gap-6 transition-all duration-500 hover:bg-white/10">
          <div class="aspect-[4/3] bg-black/60 rounded-2xl overflow-hidden flex items-center justify-center relative">
            <img src="https://images.unsplash.com/photo-1626814026160-2237a95fc5a0?q=80&w=600&auto=format&fit=crop" alt="Blu-ray" class="absolute inset-0 w-full h-full object-cover opacity-60 mix-blend-luminosity transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-br from-blue-500/20 to-purple-500/20 mix-blend-overlay"></div>
          </div>
          <div class="flex flex-col flex-1 pb-2">
            <h2 class="text-2xl font-bold uppercase tracking-wider mb-2">Cinematic Masterpiece [Blu-ray]</h2>
            <p class="text-white/60 text-sm mb-6 flex-1 leading-relaxed">Erlebe die Reise in atemberaubendem 4K und überragender Audioqualität. Enthält Behind-the-Scenes-Material und Audiokommentare des Regisseurs.</p>
            <div class="flex items-center justify-between mt-auto">
              <span class="text-xl font-mono tracking-widest font-semibold text-white/90">24,99 €</span>
              <button 
                class="snipcart-add-item bg-white text-black px-6 py-2.5 rounded-full font-bold uppercase text-xs tracking-[0.15em] transition-all duration-300 hover:scale-105"
                data-item-id="blu-ray-001"
                data-item-price="24.99"
                data-item-url="/de/shop"
                data-item-description="Erlebe die Reise in atemberaubendem 4K und überragender Audioqualität."
                data-item-image="https://images.unsplash.com/photo-1626814026160-2237a95fc5a0?q=80&w=600&auto=format&fit=crop"
                data-item-name="Cinematic Masterpiece (Blu-ray)"
              >
                In den Warenkorb
              </button>
            </div>
          </div>
        </div>

        {/* Product 2: T-shirt */}
        <div class="relative group rounded-3xl overflow-hidden bg-white/5 border border-white/10 backdrop-blur-md p-6 flex flex-col gap-6 transition-all duration-500 hover:bg-white/10">
          <div class="aspect-[4/3] bg-black/60 rounded-2xl overflow-hidden flex items-center justify-center relative">
            <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?q=80&w=600&auto=format&fit=crop" alt="T-Shirt" class="absolute inset-0 w-full h-full object-cover opacity-60 mix-blend-luminosity transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-br from-purple-500/20 to-pink-500/20 mix-blend-overlay"></div>
          </div>
          <div class="flex flex-col flex-1 pb-2">
            <h2 class="text-2xl font-bold uppercase tracking-wider mb-2">Signature Box Tee</h2>
            <p class="text-white/60 text-sm mb-6 flex-1 leading-relaxed">Premium T-Shirt aus schwerer Baumwolle mit klassischem Branding. Relaxed Fit – designed für lange Drehtage.</p>
            <div class="flex items-center justify-between mt-auto">
              <span class="text-xl font-mono tracking-widest font-semibold text-white/90">39,00 €</span>
              <button 
                class="snipcart-add-item bg-white text-black px-6 py-2.5 rounded-full font-bold uppercase text-xs tracking-[0.15em] transition-all duration-300 hover:scale-105"
                data-item-id="apparel-tee-001"
                data-item-price="39.00"
                data-item-url="/de/shop"
                data-item-description="Premium T-Shirt aus schwerer Baumwolle mit klassischem Branding."
                data-item-image="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?q=80&w=600&auto=format&fit=crop"
                data-item-name="Signature Box Tee"
                data-item-custom1-name="Größe"
                data-item-custom1-options="S|M|L|XL|XXL"
              >
                In den Warenkorb
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer lang="de" client:load />
</Layout>
