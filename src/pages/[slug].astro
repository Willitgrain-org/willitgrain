---
import Layout from '@/layouts/main.astro';
import { Header } from '@/components/Header';
import { Footer } from '@/components/Footer';
import { getCollection, type CollectionEntry } from 'astro:content';
import { ImageGridWithLightbox } from '@/components/ImageGridWithLightbox';
import { ExpandablePoster } from '@/components/ExpandablePoster';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p: CollectionEntry<'projects'>) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const data = project.data;

const trailerHref = data.trailerUrl || "https://www.youtube.com/watch?v=w0hGIOXk90s";
const trailerEmbed = trailerHref.replace('watch?v=', 'embed/');
---

<Layout title={data.title || ""} lang="en">
  <Header lang="en" client:load currentProjectSlug={project.id} />

  <main class="relative z-10 flex flex-col w-full min-h-screen pt-28 md:pt-32 pb-24 text-white px-4 md:px-8 xl:px-12 mx-auto max-w-[1600px]">

    <div class="mb-8 relative z-10">
      <a href="/" class="inline-flex items-center text-white/50 hover:text-white/90 transition-colors font-mono text-[10px] md:text-xs uppercase tracking-widest gap-3 backdrop-blur-md bg-white/[0.03] border border-white/10 px-4 py-2 rounded-full">
        <span>←</span> Back to Overview
      </a>
    </div>

    <div class="flex flex-col md:flex-row gap-8 lg:gap-12 xl:gap-16 items-start relative z-10">
      
      {/* LEFT COLUMN: Title/Synopsis AND Poster */}
      <div class="w-full md:w-5/12 lg:w-4/12 flex-shrink-0 flex flex-col gap-6 md:gap-8 md:sticky md:top-32 animate-in fade-in slide-in-from-bottom-8 duration-700">
        
        {/* Title & Synopsis Box */}
        <div class="backdrop-blur-2xl bg-white/[0.03] border border-white/10 rounded-3xl shadow-[0_8px_32px_0_rgba(0,0,0,0.5)] flex flex-col relative overflow-hidden">
          
          <div class="flex-1 z-10 relative p-6 md:p-8 w-2/3 md:w-full">
            <p class="font-mono text-[10px] md:text-sm uppercase tracking-widest text-white/50 mb-4 md:mb-6 flex flex-wrap items-center gap-2 md:gap-3">
              <span>{data.en.type}</span>
              <span class="w-1 h-1 md:w-1.5 md:h-1.5 rounded-full bg-white/20"></span>
              <span>{data.en.genre}</span>
              <span class="w-1 h-1 md:w-1.5 md:h-1.5 rounded-full bg-white/20"></span>
              <span>{data.runtime}</span>
            </p>
            <h2 class="text-3xl md:text-5xl lg:text-7xl font-heading mb-4 md:mb-6 leading-tight drop-shadow-lg break-words">{data.title || "TBA"}</h2>
            
            <p class="text-sm md:text-lg text-white/80 leading-relaxed font-sans font-light mb-6 pr-2">
              {data.en.synopsis}
            </p>

            {/* Links */}
            {(data.crewUnitedUrl || data.filmfreewayUrl) && (
              <div class="flex flex-wrap gap-4 items-center pt-6 border-t border-white/10">
                {data.crewUnitedUrl && (
                  <a href={data.crewUnitedUrl} target="_blank" rel="noreferrer" class="text-[10px] md:text-xs font-mono uppercase tracking-widest text-white/80 hover:text-white transition-all backdrop-blur-md bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/30 px-4 md:px-6 py-2 md:py-3 rounded-full shadow-lg">
                    Crew United ↗
                  </a>
                )}
                {data.filmfreewayUrl && (
                  <a href={data.filmfreewayUrl} target="_blank" rel="noreferrer" class="text-[10px] md:text-xs font-mono uppercase tracking-widest text-white/80 hover:text-white transition-all backdrop-blur-md bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/30 px-4 md:px-6 py-2 md:py-3 rounded-full shadow-lg">
                    FilmFreeway ↗
                  </a>
                )}
              </div>
            )}
          </div>

          {/* Mobile Poster taking full height on right side */}
          <div class="md:hidden absolute top-0 right-0 w-[40%] h-full overflow-hidden" style="mask-image: linear-gradient(to right, transparent 0%, black 25%, black 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 25%, black 100%);">
             <div class="w-full h-full">
               <ExpandablePoster client:load src={data.posterUrl || ""} alt={data.title || "Poster"} />
             </div>
          </div>

        </div>

        {/* Desktop Poster (hidden on mobile) */}
        <div class="hidden md:flex justify-center border border-white/10 rounded-3xl p-4 lg:p-8 backdrop-blur-md bg-white/[0.01]">
            <ExpandablePoster client:load src={data.posterUrl || ""} alt={data.title || "Poster"} />
        </div>

      </div>

      {/* RIGHT COLUMN: Trailer, Billing, Grids */}
      <div class="w-full md:w-7/12 lg:w-8/12 flex flex-col gap-8 animate-in fade-in slide-in-from-bottom-12 duration-1000 delay-150">
        
        {/* 1. Trailer Block - VERY TOP */}
        <div class="backdrop-blur-2xl bg-white/[0.03] border border-white/10 rounded-3xl p-4 md:p-8 shadow-[0_8px_32px_0_rgba(0,0,0,0.5)]">
           <div class="w-full aspect-video rounded-xl overflow-hidden bg-black/50 shadow-2xl border border-white/10 relative z-20">
             <iframe
               width="100%"
               height="100%"
               src={trailerEmbed}
               title="Trailer"
               frameborder="0"
               allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
               allowfullscreen
               loading="lazy"
               class="absolute inset-0"
             />
           </div>
        </div>

        {/* 2. Billing Block */}
        <div class="backdrop-blur-2xl bg-white/[0.03] border border-white/10 rounded-3xl p-6 md:p-10 shadow-[0_8px_32px_0_rgba(0,0,0,0.5)] tracking-wider leading-relaxed text-white/80">
          
          <div class="font-sans text-[10px] md:text-sm text-center uppercase mx-auto space-y-4 whitespace-pre-wrap flex flex-col items-center">
            {/* Header Block from Markdown */}
            {data.en.billingHeader && (
               <span class="block mb-2 font-mono tracking-widest opacity-60 w-full">{data.en.billingHeader}</span>
            )}

            {/* Middle Grid of Crew Names */}
            {data.crewEn ? (
              <span class="block mt-4 md:mt-6 opacity-90 leading-loose">
                {data.crewEn.map(({ role, name }) => (
                  <span>
                    <span class="font-mono tracking-widest opacity-60 mr-2 text-[8px] md:text-[10px]">{role}</span> {name} <br />
                  </span>
                ))}
              </span>
            ) : (
                <span class="block font-semibold my-4">TBA</span>
            )}
          </div>

          {/* Footer Block from Markdown */}
          {data.en.billingFooter && (
            <p class="mt-8 text-[8px] md:text-xs font-mono opacity-40 uppercase tracking-widest text-center max-w-2xl mx-auto leading-loose whitespace-pre-wrap">
              {data.en.billingFooter}
            </p>
          )}

        </div>

        {/* 4. Stills Grid */}
        <ImageGridWithLightbox client:load title="Stills" images={data.stills || []} />

        {/* 5. Behind the Scenes Grid */}
        <ImageGridWithLightbox client:load title="Behind The Scenes" images={data.bts || []} />

      </div>
    </div>
  </main>
  
  <Footer lang="en" client:load />
</Layout>
