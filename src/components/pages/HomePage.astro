---
/** Homepage, shared by / (EN) and /de (DE). */
import Layout from '@/layouts/main.astro';
import { Header } from '@/components/Header';
import { HomeGallery, type HomeProject } from '@/components/HomeGallery';
import { Footer } from '@/components/Footer';
import { getCollection } from 'astro:content';
import { getProjectPreview } from '@/lib/projectImages';
import { getResponsiveImage, IMAGE_PRESETS } from '@/lib/images';
import { localizePath, type Lang } from '@/lib/i18n';
import { organizationJsonLd, SITE_DESCRIPTION } from '@/lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const t = {
  en: { title: 'WILLIT GRAIN – Film Production', heading: 'WILLIT GRAIN – Film Production Company' },
  de: { title: 'WILLIT GRAIN – Filmproduktion', heading: 'WILLIT GRAIN – Filmproduktion' },
}[lang];

const allProjects = await getCollection('projects');
const projects: HomeProject[] = await Promise.all(
  allProjects.map(async (p) => {
    const text = p.data[lang];
    const preview = getProjectPreview(p.id) ?? p.data.posterUrl;
    return {
      slug: p.id,
      title: text.title || p.data.title || '',
      synopsis: text.synopsis || '',
      genre: text.genre || '',
      image: preview ? await getResponsiveImage(preview, IMAGE_PRESETS.card) : null,
    };
  })
);

const site = Astro.site!;
const jsonLd = [
  organizationJsonLd(site),
  {
    '@type': 'WebSite',
    '@id': new URL('/#website', site).href,
    url: new URL('/', site).href,
    name: 'WILLIT GRAIN',
    inLanguage: lang,
    publisher: { '@id': new URL('/#organization', site).href },
  },
  {
    '@type': 'ItemList',
    itemListElement: projects.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(localizePath(`/${p.slug}`, lang), site).href,
      name: p.title,
    })),
  },
];
---

<Layout lang={lang} title={t.title} description={SITE_DESCRIPTION[lang]} jsonLd={jsonLd}>
  <Header lang={lang} client:load />
  <main class="flex flex-1 flex-col">
    <h1 class="sr-only">{t.heading}</h1>
    <HomeGallery lang={lang} projects={projects} client:load />
  </main>
  <Footer lang={lang} client:load />
</Layout>
