---
/**
 * Project detail page, shared by /[slug] (EN) and /de/[slug] (DE).
 * Language-specific text lives in `t` below; content comes from the
 * project's YAML (data.en / data.de, crewEn / crewDe).
 */
import Layout from '@/layouts/main.astro';
import { Header } from '@/components/Header';
import { Footer } from '@/components/Footer';
import type { CollectionEntry } from 'astro:content';
import { ImageGridWithLightbox } from '@/components/ImageGridWithLightbox';
import { ExpandablePoster } from '@/components/ExpandablePoster';
import { getProjectImages, getProjectPreview } from '@/lib/projectImages';
import { getResponsiveImage, getResponsiveImages, IMAGE_PRESETS } from '@/lib/images';
import { getTrailerEmbedUrl } from '@/lib/trailer';
import TrailerEmbed from '@/components/TrailerEmbed.astro';
import { parseCrew } from '@/lib/utils';
import { longestWordEm } from '@/lib/titleFit';
import { localizePath, type Lang } from '@/lib/i18n';
import { organizationJsonLd, runtimeToIso, socialImagePath, truncate } from '@/lib/seo';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
}

const { project, lang } = Astro.props;
const data = project.data;
const text = data[lang];

const t = {
  en: {
    home: '/',
    back: 'Back to Overview',
    project: 'Project',
    trailer: (title: string) => `${title} Trailer`,
  },
  de: {
    home: '/de/',
    back: 'Zurück zur Übersicht',
    project: 'Projekt',
    trailer: (title: string) => `${title} – Trailer`,
  },
}[lang];

const title = text.title || data.title || '';
const crew = parseCrew(lang === 'en' ? data.crewEn : data.crewDe);

const [stills, bts, poster] = await Promise.all([
  getResponsiveImages(getProjectImages(project.id, 'stills'), IMAGE_PRESETS.grid),
  getResponsiveImages(getProjectImages(project.id, 'bts'), IMAGE_PRESETS.grid),
  data.posterUrl ? getResponsiveImage(data.posterUrl, IMAGE_PRESETS.poster) : null,
]);

const trailerEmbed = getTrailerEmbedUrl(data.trailerUrl);
// Our own still as the trailer placeholder (nothing loads from YouTube/Vimeo before the click)
const trailerStill = getProjectPreview(project.id) ?? getProjectImages(project.id, 'stills')[0] ?? data.posterUrl;
const trailerImage =
  trailerEmbed && trailerStill ? await getResponsiveImage(trailerStill, IMAGE_PRESETS.wide) : null;
// --- SEO ---
const typeGenre = [text.type, text.genre].filter(Boolean).join(', ');
const pageTitle = `${title || t.project}${typeGenre ? ` – ${typeGenre}` : ''} | WILLIT GRAIN`;
const description = truncate(text.synopsis || `${title} – ${typeGenre}`);
const socialSrc = getProjectPreview(project.id) ?? getProjectImages(project.id, 'stills')[0] ?? data.posterUrl;
const socialImage = socialSrc ? socialImagePath(socialSrc) : undefined;

const site = Astro.site!;
const roleOf = (re: RegExp) => crew.filter((c) => re.test(c.role)).flatMap((c) => c.name.split(/,\s*/));
const people = (names: string[]) =>
  names.length ? names.map((name) => ({ '@type': 'Person', name })) : undefined;
const movie = {
  '@type': 'Movie',
  '@id': new URL(`${localizePath(`/${project.id}`, lang)}#movie`, site).href,
  name: title,
  url: new URL(localizePath(`/${project.id}`, lang), site).href,
  description: text.synopsis || undefined,
  genre: text.genre || undefined,
  duration: runtimeToIso(data.runtime),
  image: data.posterUrl ? new URL(data.posterUrl, site).href : socialImage ? new URL(socialImage, site).href : undefined,
  director: people(roleOf(/^(directed by|director|regie)$/i)),
  author: people(roleOf(/^(writers?|screenplay|drehbuch)$/i)),
  producer: people(roleOf(/^(producers?|produzent(en|in)?)$/i)),
  productionCompany: { '@id': new URL('/#organization', site).href },
  sameAs: [data.filmfreewayUrl, data.crewUnitedUrl].filter(Boolean),
};
const jsonLd = [organizationJsonLd(site), movie];

const linkClass =
  'text-[10px] md:text-xs font-mono uppercase tracking-widest text-white/80 hover:text-white transition-all backdrop-blur-md bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/30 px-4 md:px-6 py-2 md:py-3 rounded-full shadow-lg';
---

<Layout
  title={pageTitle}
  lang={lang}
  description={description}
  image={socialImage}
  imageAlt={title}
  type="video.movie"
  jsonLd={jsonLd}
>
  <Header lang={lang} client:load currentProjectSlug={project.id} />

  <main class="relative z-10 flex flex-col w-full min-h-screen pt-28 md:pt-32 pb-24 text-white px-4 md:px-8 xl:px-12 mx-auto max-w-[1600px]">
    <div class="mb-8 relative z-10">
      <a
        href={t.home}
        class="inline-flex items-center text-white/50 hover:text-white/90 transition-colors font-mono text-[10px] md:text-xs uppercase tracking-widest gap-3 backdrop-blur-md bg-white/[0.03] border border-white/10 px-4 py-2 rounded-full"
      >
        <span>←</span>
        {t.back}
      </a>
    </div>

    <div class="flex flex-col md:flex-row gap-8 lg:gap-12 xl:gap-16 items-start relative z-10">
      {/* LEFT COLUMN */}
      <div class="w-full md:w-5/12 lg:w-4/12 flex-shrink-0 flex flex-col gap-6 md:gap-8 md:sticky md:top-32 animate-in fade-in slide-in-from-bottom-8 duration-700">
        <div class="border border-white/10 rounded-3xl flex flex-col relative overflow-hidden">
          <div class="flex-1 z-10 relative p-6 md:p-8 w-2/3 md:w-full">
            <p class="font-mono text-[10px] md:text-sm uppercase tracking-widest text-white/50 mb-4 md:mb-6 flex flex-wrap items-center gap-2 md:gap-3">
              <span>{text.type}</span>
              <span class="w-1 h-1 md:w-1.5 md:h-1.5 rounded-full bg-white/20"></span>

              <span>{text.genre}</span>
              <span class="w-1 h-1 md:w-1.5 md:h-1.5 rounded-full bg-white/20"></span>

              <span>{data.runtime}</span>
            </p>

            {/* Font size shrinks so the longest word always fits the column */}
            <div class="@container">
              <h1
                class="project-title font-heading mb-4 md:mb-6 leading-tight drop-shadow-lg break-words"
                style={`--title-em: ${longestWordEm(title || 'TBA')}`}
              >
                {title || 'TBA'}
              </h1>
            </div>

            <p class="text-sm md:text-lg text-white/80 leading-relaxed font-sans font-light mb-6 pr-2">
              {text.synopsis}
            </p>

            {(data.crewUnitedUrl || data.filmfreewayUrl) && (
              <div class="flex flex-wrap gap-4 items-center pt-6 border-t border-white/10">
                {data.crewUnitedUrl && (
                  <a href={data.crewUnitedUrl} target="_blank" rel="noreferrer" class={linkClass}>
                    Crew United ↗
                  </a>
                )}

                {data.filmfreewayUrl && (
                  <a href={data.filmfreewayUrl} target="_blank" rel="noreferrer" class={linkClass}>
                    FilmFreeway ↗
                  </a>
                )}
              </div>
            )}
          </div>

          {poster && (
            <div
              class="md:hidden absolute top-0 right-0 w-[40%] h-full overflow-hidden"
              style="mask-image: linear-gradient(to right, transparent 0%, black 25%, black 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 25%, black 100%);"
            >
              <div class="w-full h-full">
                <ExpandablePoster client:load image={poster} alt={`${title || t.project} – Poster`} />
              </div>
            </div>
          )}
        </div>

        {poster && (
          <div class="hidden md:flex justify-center border border-white/10 rounded-3xl p-4 lg:p-8">
            <ExpandablePoster client:load image={poster} alt={`${title || t.project} – Poster`} />
          </div>
        )}
      </div>

      {/* RIGHT COLUMN */}
      <div class="w-full md:w-7/12 lg:w-8/12 flex flex-col gap-8 animate-in fade-in slide-in-from-bottom-12 duration-1000 delay-150">
        {/* Only shown if trailerUrl is a valid YouTube or Vimeo link */}
        {trailerEmbed && (
          <div class="border border-white/10 rounded-3xl p-4 md:p-8">
            <TrailerEmbed
              embedUrl={trailerEmbed}
              title={t.trailer(title || t.project)}
              lang={lang}
              image={trailerImage}
            />
          </div>
        )}

        <div class="border border-white/10 rounded-3xl p-6 md:p-10 tracking-wider leading-relaxed text-white/80">
          <div class="font-sans text-[10px] md:text-sm text-center uppercase mx-auto space-y-4 whitespace-pre-wrap flex flex-col items-center">
            {text.billingHeader && (
              <span class="block mb-2 font-mono tracking-widest opacity-60 w-full">
                {text.billingHeader}
              </span>
            )}

            {crew.length > 0 ? (
              <span class="block mt-4 md:mt-6 opacity-90 leading-loose">
                {crew.map(({ role, name }) => (
                  <span>
                    <span class="font-mono tracking-widest opacity-60 mr-2 text-[8px] md:text-[10px]">
                      {role}
                    </span>
                    {' '}
                    {name}
                    <br />
                  </span>
                ))}
              </span>
            ) : (
              <span class="block font-semibold my-4">TBA</span>
            )}
          </div>

          {text.billingFooter && (
            <p class="mt-8 text-[8px] md:text-xs font-mono opacity-40 uppercase tracking-widest text-center max-w-2xl mx-auto leading-loose whitespace-pre-wrap">
              {text.billingFooter}
            </p>
          )}
        </div>

        <ImageGridWithLightbox client:load title="Stills" altPrefix={title} images={stills} />

        <ImageGridWithLightbox client:load title="Behind The Scenes" altPrefix={title} images={bts} />
      </div>
    </div>
  </main>

  <Footer lang={lang} client:load />
</Layout>
